# Porter: environment variables shared by every server.
# Copy to .env for local runs. Never commit real values.

# Transport: "stdio" for local clients (Claude Desktop/Code, Cursor, VS Code) or "http" for Streamable HTTP.
PORTER_TRANSPORT=stdio

# HTTP mode only. Loopback binds accept only localhost Host headers (DNS-rebinding protection).
PORTER_HTTP_HOST=127.0.0.1
PORTER_HTTP_PORT=3000

# HTTP mode, non-loopback bind only: comma-separated public hostnames allowed in Host/Origin.
# Required when PORTER_HTTP_HOST is e.g. 0.0.0.0. Example: porter-demo.example.workers.dev
PORTER_ALLOWED_HOSTS=

# fatal | error | warn | info | debug | trace | silent. Logs always go to stderr.
LOG_LEVEL=info

# Re-record HTTP test fixtures against live upstreams (tests only): PORTER_FIXTURES=record
# PORTER_FIXTURES=

# --- porter-opendata ---
# Cache for downloaded CSVs and the StatCan table list (default: $XDG_CACHE_HOME/porter or ~/.cache/porter).
# PORTER_CACHE_DIR=
# Largest CSV preview_resource/query_resource will download, in MB.
PORTER_MAX_DOWNLOAD_MB=100
# Time limit (ms) and row cap for one query_resource SQL query.
PORTER_SQL_TIMEOUT_MS=5000
PORTER_SQL_MAX_ROWS=200
