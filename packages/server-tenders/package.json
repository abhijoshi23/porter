{
  "name": "@abhijoshi23/porter-tenders",
  "version": "0.1.0",
  "description": "MCP server for Canadian federal tenders (CanadaBuys): search open and recent notices, read one, and pull out what decides whether to bid.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.abhijoshi23/porter-tenders",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhijoshi23/porter.git",
    "directory": "packages/server-tenders"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "porter-tenders": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/bin.js",
    "inspect": "npx -y @modelcontextprotocol/inspector@2.13.0 node dist/bin.js"
  },
  "dependencies": {
    "@abhijoshi23/porter-toolkit": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
